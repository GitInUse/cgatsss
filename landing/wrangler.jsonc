{
  "name": "idontthinkiwill-home",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/no-*",
      "/no-media/*"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "idontthinkiwill.com/*",
      "zone_name": "idontthinkiwill.com"
    }
  ],
  "main": "worker.js",
  "kv_namespaces": [
    {
      "binding": "NO_MEMES",
      "id": "d687bafba1084db3be4278df75a36c11"
    }
  ]
}
