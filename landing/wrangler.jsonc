{
  "name": "idontthinkiwill-home",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "idontthinkiwill.com/*",
      "zone_name": "idontthinkiwill.com"
    }
  ],
  "main": "worker.js",
  "kv_namespaces": [
    {
      "binding": "NO_MEMES",
      "id": "d687bafba1084db3be4278df75a36c11"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2026102501",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "267494127627-q3dn4bai8ibqs652754726e8nk1fhie8.apps.googleusercontent.com"
  }
}
