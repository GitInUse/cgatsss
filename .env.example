PORT=3000
DATA_DIR=./data
# Set a unique password of at least 12 characters. No default password exists.
HOST_PASSWORD=
# Separate recovery code, 8–128 characters. Keep it somewhere private.
HOST_RECOVERY_CODE=
# Production only: the exact public https origin, with no trailing slash.
PUBLIC_ORIGIN=
NODE_ENV=development
# Render sets this to true. The server refuses an ephemeral data directory.
REQUIRE_PERSISTENT_DISK=false
PERSISTENT_DISK_PATH=/var/data
